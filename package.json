{
    "name": "claim-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Web-based Monday.com claim management tool with IBM Carbon UI",
    "bin": {
        "claim-ui": "./launcher.js"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:client": "vite",
        "dev:server": "node server/index.mjs",
        "build": "vite build",
        "start": "node server/index.mjs",
        "launch": "node launcher.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
    },
    "dependencies": {
        "@carbon/react": "^1.66.0",
        "@carbon/styles": "^1.66.0",
        "@carbon/charts-react": "^1.15.0",
        "@carbon/icons-react": "^11.49.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.0",
        "i18next": "^23.12.0",
        "react-i18next": "^15.0.0",
        "i18next-browser-languagedetector": "^8.0.0",
        "express": "^4.19.0",
        "cors": "^2.8.5",
        "sass": "^1.77.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.0.0",
        "@testing-library/jest-dom": "^6.4.0",
        "@testing-library/user-event": "^14.5.0",
        "@playwright/test": "^1.45.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "concurrently": "^8.2.0",
        "jsdom": "^24.1.0",
        "vitest": "^1.6.0",
        "vite": "^5.4.0",
        "typescript": "^5.5.0"
    }
}